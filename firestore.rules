rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Verify if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Verify user owns the document path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Gamification validation for user document
    function isValidUserDoc(data) {
      return !('gamification' in data) || (
        data.gamification.hearts is number &&
        data.gamification.hearts >= 0 &&
        data.gamification.totalXp is number &&
        data.gamification.totalXp >= 0
      );
    }

    // Root user document (Profile & Gamification stats)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidUserDoc(request.resource.data);

      // All user subcollections (/categories, /habits, /logs, /habitBreaks, /challenges, etc.)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Explicit fallback: Deny all unauthenticated or stray collection access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
