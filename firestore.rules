rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Verify if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Verify user owns the document path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Gamification validation for user profile document
    function isValidUserDoc(data) {
      return !('gamification' in data) || (
        data.gamification.hearts is number &&
        data.gamification.hearts >= 0 &&
        data.gamification.totalXp is number &&
        data.gamification.totalXp >= 0
      );
    }

    // Root user document (Profile & Gamification stats)
    match /users/{userId} {
      allow read: if isOwner(userId);
      // Explicitly separate create/update from delete so request.resource is never checked on deleteDoc
      allow create, update: if isOwner(userId) && isValidUserDoc(request.resource.data);
      allow delete: if isOwner(userId);

      // Explicitly mapped user subcollections
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }
      match /habits/{habitId} {
        allow read, write: if isOwner(userId);
      }
      match /logs/{logKey} {
        allow read, write: if isOwner(userId);
      }
      match /habitBreaks/{breakId} {
        allow read, write: if isOwner(userId);
      }
      match /challenges/{challengeId} {
        allow read, write: if isOwner(userId);
      }

      // Safe recursive fallback for any nested user subcollection documents
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Explicit fallback: Deny all unauthenticated or stray root collection access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
